{
  "name": "@lolkda/dsh-agent-team-model-pin",
  "version": "1.3.0-rc.1",
  "description": "DSH Host/Web plugin: choose per-session Agent Team models and reasoning effort in the composer",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "agent-team",
    "teammate",
    "llm",
    "model",
    "reasoning-effort"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/index.d.ts",
      "default": "./dist/web.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:tap": "node --test --test-reporter=tap tests/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "smoke:dist": "node -e \"Promise.all([import('./dist/index.js'),import('./dist/web.js')]).then(ms=>{for(const m of ms){if(m.name!=='agent-team-model-pin'||typeof m.apply!=='function')throw new Error('dist entry smoke failed')}console.log('Host and Web entries OK')})\" && node --check dist/client.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run smoke:dist"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.7-rc.1",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.1.7-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.1",
    "@deepseek-ai/dsh-util-values": "0.1.7-rc.1",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "immer": "10.1.1",
    "jsdom": "^30.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^7.0.2",
    "zustand": "4.4.7"
  },
  "license": "MIT",
  "author": "lolkda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lolkda/dsh-agent-team-model-pin.git"
  },
  "homepage": "https://github.com/lolkda/dsh-agent-team-model-pin#readme",
  "bugs": {
    "url": "https://github.com/lolkda/dsh-agent-team-model-pin/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-settings-controller"
      ],
      "external": [
        "react-dom",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
